                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the created task with an id', () => { pm.expect(body.success).to.be.true; pm.expect(body.data.id).to.be.a('string'); pm.expect(body.data.text).to.eql('Finish Week 3 backend'); pm.expect(body.data.completed).to.be.false; pm.expect(body.data).to.not.have.property('_id'); });",
                  "pm.collectionVariables.set('taskId', body.data.id);"
                ]
              }
            }
          ]
